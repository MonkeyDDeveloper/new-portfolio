# ============================================
# Configuración de la API - Seenode Deployment
# ============================================

# Entorno de ejecución (development, staging, production)
ENVIRONMENT=production

# ============================================
# BASE DE DATOS
# ============================================
# MySQL (Dev and prod)
ADMIN_PASSWORD=
DATABASE=
USERNAME=
PASSWORD=
HOST=
DB_PORT=

# JWT
SECRET_KEY=
ALGORITHM=


# ============================================
# WHITELIST DE IPs y ORIGINS
# ============================================
# IPs que pueden acceder sin autenticación (separadas por coma)
# Incluye las IPs de tus servidores, servicios o clientes de confianza
WHITELISTED_IPS=127.0.0.1

# Dominios/Origins permitidos sin autenticación (separados por coma)
# Ejemplo: https://tu-frontend.seenode.com,https://otro-dominio.com
WHITELISTED_ORIGINS=

# ============================================
# SERVIDOR (Seenode)
# ============================================
# Puerto en el que corre la aplicación
# En Seenode, configura este mismo puerto en el dashboard
PORT=